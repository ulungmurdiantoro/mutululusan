# URL kanonis situs (tanpa trailing slash)
NEXT_PUBLIC_SITE_URL=https://mutululusan.id

# Kontak
NEXT_PUBLIC_WHATSAPP=6281234567890
NEXT_PUBLIC_CONTACT_EMAIL=halo@mutululusan.id

# Midtrans — ambil dari dashboard.midtrans.com (Settings > Access Keys)
# Gunakan key SANDBOX dulu; set NEXT_PUBLIC_MIDTRANS_PRODUCTION=true saat go-live.
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_PRODUCTION=false

# ── Fase 3: Otomasi & Recovery ──────────────────────────────────
# Email transaksional via Resend (resend.com). Kosongkan untuk menonaktifkan.
RESEND_API_KEY=
RESEND_FROM="mutululusan.id <noreply@mutululusan.id>"

# WhatsApp API via Fonnte (fonnte.com). Kosongkan untuk menonaktifkan.
FONNTE_TOKEN=
# Nomor admin penerima notifikasi internal (mis. invoice instansi baru)
ADMIN_WHATSAPP=6281234567890

# Detail rekening untuk proforma invoice instansi
BANK_NAME=BCA
BANK_ACCOUNT=1234567890
BANK_HOLDER="PT Mutu Lulusan Indonesia"

# Token untuk endpoint cron reminder/recovery (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Token login dashboard admin (/admin)
ADMIN_TOKEN=

# ── Fase 4: Growth & Analytics ──────────────────────────────────
# Google Analytics 4 (mis. G-XXXXXXXXXX). Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_GA_ID=
# Meta (Facebook) Pixel ID. Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_META_PIXEL_ID=
# Kode verifikasi Google Search Console (metode "Tag HTML" — search.google.com/search-console
# > Add property > URL prefix > HTML tag). Isi HANYA isi atribut content="..."-nya, bukan
# seluruh tag <meta>. Kosongkan untuk menonaktifkan.
GOOGLE_SITE_VERIFICATION=

# ── Fase 5: Akun Pengguna, Database & Login Google ──────────────
# PostgreSQL (self-host di VPS via Docker, atau managed Neon/Supabase).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Catatan: pada deployment Docker Compose (VPS), DATABASE_URL aplikasi diisi
# OTOMATIS oleh docker-compose (menunjuk ke service "db"). Untuk dev lokal,
# isi manual ke Postgres lokal Anda.
DATABASE_URL=

# Password PostgreSQL untuk Docker Compose di VPS (dipakai membuat DB &
# menyusun DATABASE_URL aplikasi secara otomatis). Pilih yang kuat & acak.
POSTGRES_PASSWORD=

# Auth.js (NextAuth v5)
# AUTH_SECRET: hasilkan dengan  npx auth secret   atau  openssl rand -base64 32
AUTH_SECRET=
# URL dasar aplikasi — dev: http://localhost:3000 ; produksi: https://mutululusan.id
AUTH_URL=http://localhost:3000

# Google OAuth — dari Google Cloud Console (APIs & Services > Credentials)
# Redirect URI yang didaftarkan: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email yang otomatis dijadikan admin saat login (pisahkan dengan koma bila >1)
ADMIN_EMAILS=
